# IBKR Configuration
IBEAM_ACCOUNT=IBKR_USERNAME
IBEAM_PASSWORD=IBKR_PASSWORD
IBEAM_INPUTS_DIR=/srv/inputs/
# Host port for the iBeam gateway (macOS AirPlay Receiver uses 5000)
IBEAM_HOST_PORT=5050

# Environment Configuration
NODE_ENV=development  # or 'production'
BUILD_MODE=development  # or 'production'
STDIN_OPEN=true
# STDIN_OPEN=false  # for production